{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A trailer product listing",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "brand": { "type": "string" },
        "price": { "type": "string" },
        "status": { "type": "boolean" },
        "inStock": { "type": "boolean" },
        "sequence": { "type": "string" },
        "image": { "type": "string" },
        "gallery": {
          "type": "array",
          "items": { "type": "string" }
        },
        "description": { "type": "string" },
        "shortSpecs": { "type": "string" },
        "specifications": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "number" },
              "key": { "type": "string" },
              "val": { "type": "string" }
            }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "price", "image"]
    }
  },
  "firestore": {
    "products/{productId}": {
      "schema": "Product",
      "description": "Inventory of trailer products"
    }
  }
}
